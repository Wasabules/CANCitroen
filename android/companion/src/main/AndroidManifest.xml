<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Exigée par la tâche périodique persistante. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- CarConnection interroge le fournisseur d'Android Auto. -->
    <queries>
        <package android:name="com.google.android.projection.gearhead" />
    </queries>

    <!-- Clair autorisé pour un Home Assistant en http sur le réseau local : Android ne sait
         pas le limiter aux adresses privées, HaUrl refuse donc http partout ailleurs. -->
    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:usesCleartextTraffic="true"
        android:theme="@android:style/Theme.Material.NoActionBar">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".TransferJobService"
            android:exported="false"
            android:permission="android.permission.BIND_JOB_SERVICE" />

        <receiver
            android:name=".TransferReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="androidx.car.app.connection.action.CAR_CONNECTION_UPDATED" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
